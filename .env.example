# Copy this file to .env and fill in real values. Never commit .env.

# Port the Node server listens on (put behind nginx/Caddy for HTTPS in production)
PORT=3000

# Long random string used to sign session cookies AND to encrypt saved FTP/SFTP
# passwords at rest. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Login for the web app itself (this is NOT your FTP/SFTP login — it's who is
# allowed to open this tool at all). Generate the hash with:
#   npm run hash-password -- "your-chosen-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$m9WgB8xB32yoLCZAnhMfEOKqjDOg3mbCcEImLqt.8DQo0wZGc0kRC

# Set to "true" once you are serving this over HTTPS (via a reverse proxy).
# When true, the session cookie is marked Secure and will NOT be sent over plain HTTP.
COOKIE_SECURE=false
